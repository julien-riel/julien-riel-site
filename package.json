{
  "name": "julien-riel-site",
  "version": "1.0.0",
  "description": "Blog sur l'informatique et l'IA - julien-riel.com",
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "npm run clean && npm run build:livrer && eleventy && node scripts/generate-feed.js && node scripts/generate-og-images.js && node scripts/generate-sitemap.js",
    "build:prod": "NODE_ENV=production npm run build",
    "clean": "rm -rf _site",
    "preview": "npx serve _site -p 3000",
    "lint": "echo 'No linter configured'",
    "test": "npx playwright test",
    "lighthouse": "npx lhci autorun",
    "lighthouse:ci": "npm run build:prod && npm run lighthouse",
    "build:livrer": "node scripts/build-livrer-a-tout-prix.js",
    "test:livrer": "node --test 'jeux/livrer-a-tout-prix/tests/*.test.js' && node scripts/build-livrer-a-tout-prix.js --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julien-riel/julien-riel-site.git"
  },
  "keywords": [
    "blog",
    "eleventy",
    "vite",
    "informatique",
    "ia"
  ],
  "author": "Julien Riel",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/julien-riel/julien-riel-site/issues"
  },
  "homepage": "https://github.com/julien-riel/julien-riel-site#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/eleventy-plugin-vite": "^7.0.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.57.0",
    "esbuild": "^0.27.2",
    "lunr": "^2.3.9",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "mermaid": "^11.12.2",
    "serve": "^14.2.4",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.26.0",
    "three": "^0.170.0"
  }
}
