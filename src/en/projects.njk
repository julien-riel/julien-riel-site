---
layout: base.njk
title: My Projects
description: Small tools and experiments built with agentic programming — usable right in the browser.
permalink: /en/projets/
lang: en
---

<div class="sites-page">
  <header class="page-header">
    <h1 class="page-title">{{ title }}</h1>
    <p class="page-description">{{ description }}</p>
  </header>

  <ul class="sites-grid">
    {% for projet in projets %}
    <li class="site-item">
      <a href="{{ projet.url }}" class="site-link">
        <span class="site-name">{{ projet.emoji }} {{ projet.name.en }}</span>
        <span class="site-description">{{ projet.description.en }}</span>
        {% if projet.date %}<span class="site-url">Built on {{ projet.date | dateFormat("long", "en") }}{% if projet.modele %} with {{ projet.modele }}{% endif %}</span>{% endif %}
      </a>
    </li>
    {% endfor %}
  </ul>
</div>
